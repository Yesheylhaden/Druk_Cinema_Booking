FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
COPY services/catalog/package.json services/catalog/package.json
COPY services/bookings/package.json services/bookings/package.json
COPY services/gateway/package.json services/gateway/package.json
RUN npm ci --omit=dev --workspace @druk/catalog --workspace @druk/bookings
COPY services services
USER node
CMD ["node","services/catalog/src/server.js"]
