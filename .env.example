POSTGRES_PASSWORD=changeThisLocalPassword

# Local development origin; set the HTTPS origin and COOKIE_SECURE=true in production.
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Optional SMTP ticket delivery. Leave blank until your email provider is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Explicit local demo only; disabled in production.
DEMO_PAYMENTS=false

# Required server-to-server authentication. Generate a random hex string locally.
SERVICE_TOKEN=replace-with-a-random-service-token
# Production should use distinct *_DB_PASSWORD values for each service.

# Website address used by ticket QR codes. Use an address reachable from your phone.
PUBLIC_APP_URL=http://localhost:5173
